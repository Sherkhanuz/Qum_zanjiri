# Vercel'da: Project → Settings → Environment Variables. Mahalliy ishga tushirish uchun shu faylni .env deb nusxalang.

# Neon bazasi manzili (Neon → Connect → "Pooled connection" yonidagi satr). Vercel'ning Neon integratsiyasi buni o'zi qo'shadi.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Sessiya imzosi uchun tasodifiy uzun matn (kamida 32 belgi). Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Birinchi sozlash kaliti (kamida 16 belgi). Faqat /setup.html da bir marta kerak, keyin o'chirib qo'yish mumkin.
SETUP_TOKEN=
